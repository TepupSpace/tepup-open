# Copy sang tepup-(.env)/.env rồi điền giá trị thật. KHÔNG commit file .env.

# --- Database (Supabase Postgres) ---
DATABASE_URL=
DIRECT_URL=

# --- NextAuth v5 ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=
# Cần khi chạy local sau reverse proxy / port khác
AUTH_TRUST_HOST=true

# --- Supabase Storage (ảnh bài học) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Host(s) media may be loaded from, comma-separated, e.g. <ref>.supabase.co (public mirror builds only)
NEXT_PUBLIC_MEDIA_STORAGE_HOSTS=

# --- AI ---
GROQ_API_KEY=
ANTHROPIC_API_KEY=


# --- Scripts quản trị ---
# scripts/cleanup-and-setup-admin.ts dùng ADMIN_USERNAME (auth username-only)
ADMIN_USERNAME=
# scripts/create-admin.ts (script cũ, query theo email)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Bắt buộc =yes để cleanup-and-setup-admin.ts được phép xóa toàn bộ user
CONFIRM_WIPE=
